# Set to the same as the NEAR contract_id in deployment.yaml
AGENT_CONTRACT_ID=
# Sponsor NEAR account details to fund the agent
# Generate by using the "shade auth set near testnet create-new" command
SPONSOR_ACCOUNT_ID=
SPONSOR_PRIVATE_KEY=
# The sponsor sent into the TEE (as SPONSOR_*): a separate account with NO key on the will contract.
# tee-agent.ts refuses a sponsor key that is an access key on AGENT_CONTRACT_ID.
TEE_SPONSOR_ACCOUNT_ID=
TEE_SPONSOR_PRIVATE_KEY=     # never commit
# Sepolia JSON-RPC (default: https://ethereum-sepolia-rpc.publicnode.com)
SEPOLIA_RPC_URL=
# NEAR testnet RPC for the agent and scripts (default: https://test.rpc.fastnear.com; rpc.testnet.near.org
# is deprecated). The agent accepts a comma-separated list with failover. FastNEAR's free tier throttles a
# busy agent (429): a keyed URL (from fastnear.com) or a second provider avoids that.
NEAR_RPC_URL=
# Will agent
BTC_API_URL=https://mempool.space/testnet4/api
GITHUB_TOKEN=
DATA_DIR=./data
TICK_SECONDS=15
# true enables SIMULATED signals (POST /demo/signal), unsigned demo routes and the demo faucet
TELEGRAM_BOT_TOKEN=          # BotFather; never commit
TELEGRAM_BOT_USERNAME=       # for t.me/<bot>?start=<token> links
DEMO_MODE=true
# Demo mode: hours a will is driven after the agent starts watching it (stops abandoned demos cycling)
DEMO_WATCH_HOURS=3
# NEAR AI Cloud (TEE inference). Without a key, policy drafting and the AI attestation badge are off.
NEARAI_API_KEY=
# Must be a model that returns an attestation report (Decision log 2026-10-27)
NEARAI_MODEL=z-ai/glm-5.3-flash
# Demo vault faucet (demo mode only; testnet keys). Funds a new demo will's empty Sepolia/BTC vaults
# once; the demo heir receives at the same addresses, so coins cycle. Both keys enable it.
DEMO_FAUCET_ETH_KEY=
DEMO_FAUCET_BTC_KEY=
DEMO_FAUCET_ETH=0.002
DEMO_FAUCET_SATS=20000
# NEAR Intents (CLAUDE.md §9A). The agent needs none of these: its 1Click client is SIMULATED and only
# reads the public token list. They are for the local, approval-gated scripts/mainnet-payout.ts.
ONECLICK_BASE_URL=https://1click.chaindefuser.com
ONECLICK_JWT=
MAINNET_DEMO_ACCOUNT=
MAINNET_DEMO_PRIVATE_KEY=
MAINNET_DEMO_DERIVATION_PATH=inheirit/demo/base
# Fallback demo vault: a plain EVM key instead of Chain Signatures
MAINNET_DEMO_EVM_KEY=
BASE_RPC_URL=https://mainnet.base.org
INTENTS_MAX_USD_PER_TX=5
INTENTS_MAX_USD_TOTAL=25
# v4 onboarding (CLAUDE.md §13A.1). Used by web/src/app/api/onboard (set in the Vercel project, never commit).
ONBOARD_PARENT_ACCOUNT=inheirit-users.testnet
ONBOARD_PARENT_KEY=          # never commit
GOOGLE_CLIENT_ID=            # Google OAuth Web client ID (public)
# Real email for checks and alerts (agent; also allowed in the TEE). Without both, email checks show in the app only.
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=           # e.g. checks@mail.your-domain.xyz (a domain verified in Resend)

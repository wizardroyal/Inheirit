# Set to the same as the NEAR contract_id in deployment.yaml
AGENT_CONTRACT_ID=
# Sponsor NEAR account details to fund the agent
# Generate by using the "shade auth set near testnet create-new" command
SPONSOR_ACCOUNT_ID=
SPONSOR_PRIVATE_KEY=
# Sepolia JSON-RPC (default: https://ethereum-sepolia-rpc.publicnode.com)
SEPOLIA_RPC_URL=
# NEAR testnet RPC for the agent and scripts (default: https://test.rpc.fastnear.com; rpc.testnet.near.org
# is deprecated). The agent accepts a comma-separated list with failover. FastNEAR's free tier throttles a
# busy agent (429): a keyed URL (from fastnear.com) or a second provider avoids that.
NEAR_RPC_URL=
# Will agent
BTC_API_URL=https://mempool.space/testnet4/api
GITHUB_TOKEN=
DATA_DIR=./data
TICK_SECONDS=15
# true enables SIMULATED signals (POST /demo/signal), unsigned demo routes and the demo faucet
DEMO_MODE=true
# Demo mode: hours a will is driven after the agent starts watching it (stops abandoned demos cycling)
DEMO_WATCH_HOURS=3
# NEAR AI Cloud (TEE inference). Without a key, policy drafting and the AI attestation badge are off.
NEARAI_API_KEY=
# Must be a model that returns an attestation report (Decision log 2026-10-27)
NEARAI_MODEL=z-ai/glm-5.3-flash
# Demo vault faucet (demo mode only; testnet keys). Funds a new demo will's empty Sepolia/BTC vaults
# once; the demo heir receives at the same addresses, so coins cycle. Both keys enable it.
DEMO_FAUCET_ETH_KEY=
DEMO_FAUCET_BTC_KEY=
DEMO_FAUCET_ETH=0.002
DEMO_FAUCET_SATS=20000

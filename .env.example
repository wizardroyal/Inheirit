# Set to the same as the NEAR contract_id in deployment.yaml
AGENT_CONTRACT_ID=
# Sponsor NEAR account details to fund the agent
# Generate by using the "shade auth set near testnet create-new" command
SPONSOR_ACCOUNT_ID=
SPONSOR_PRIVATE_KEY=# Sepolia JSON-RPC (default: https://ethereum-sepolia-rpc.publicnode.com)
SEPOLIA_RPC_URL=
# NEAR testnet RPC for scripts (default: https://test.rpc.fastnear.com; rpc.testnet.near.org is deprecated)
NEAR_RPC_URL=
# Will agent
BTC_API_URL=https://mempool.space/testnet4/api
GITHUB_TOKEN=
DATA_DIR=./data
TICK_SECONDS=15
# true enables SIMULATED signals (POST /demo/signal) and demo owner registration
DEMO_MODE=true
